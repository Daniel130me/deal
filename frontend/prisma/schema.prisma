generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Early signups captured from the DEAL landing page
model Signup {
  id           String   @id @default(cuid())
  name         String
  contact      String   @unique // email or phone number
  passwordHash String
  createdAt    DateTime @default(now())
}
