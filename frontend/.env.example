# DEAL frontend — copy to .env and fill in.

# Private origin used by the Next server to proxy same-origin /api/v1 calls.
# Keep this server-only: browser auth cookies should remain on the frontend site.
# Development defaults to http://localhost:3001 when omitted.
DEAL_API_ORIGIN=http://localhost:3001

# Render Blueprint only: injected from the API service's private host and port.
# Set either DEAL_API_ORIGIN or DEAL_API_HOSTPORT, never both.
DEAL_API_HOSTPORT=

# Optional direct browser-to-API override. Prefer leaving this unset so the
# same-origin proxy owns cookies and avoids cross-origin deployment mistakes.
NEXT_PUBLIC_API_URL=

# Local hosted-workspace routing only. Always unset in production.
NEXT_PUBLIC_API_PORT=
