generator client {
  provider = "prisma-client-js"
  // Own output dir: the backend's Postgres client generates into the shared
  // @prisma/client — this SQLite remnant must never clobber it.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Early signups captured from the DEAL landing page
model Signup {
  id           String   @id @default(cuid())
  name         String
  contact      String   @unique // email or phone number
  passwordHash String
  createdAt    DateTime @default(now())
}
