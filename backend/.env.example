# DEAL backend — copy to .env and fill in.
# This file lists ONLY variables the app actually reads (see src/config/env.ts).

# development | test | production
NODE_ENV=development

# Port the API listens on.
# In the sandbox, the preview gateway reaches this via ?XTransformPort=3001.
PORT=3001

# Maximum parsed JSON/form request size in KiB. Keep webhook bodies small so
# unauthenticated traffic cannot consume unbounded parser/signature resources.
MAX_JSON_BODY_KB=100

# Number of controlled reverse proxies between the public internet and this
# process. Keep 0 for direct exposure; use 1 only when one trusted gateway
# always fronts the API. A wrong non-zero value enables forged client IPs.
TRUST_PROXY_HOPS=0

# Browser origin(s) allowed by CORS — comma-separated for multiple. The FIRST
# origin is the primary frontend used for hosted-payment return URLs.
# Production must list the real frontend origin explicitly (never "*").
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL — pooled endpoint (PgBouncer) for the Prisma runtime.
# Named NEON_* (not DATABASE_URL): see comment in .env — the sandbox exports a
# foreign DATABASE_URL that would otherwise shadow this value for Node processes.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-x.region.aws.neon.tech/deal?sslmode=require

# Neon non-pooler host — used ONLY by Prisma CLI (migrations need a direct
# connection and a shadow database; PgBouncer transaction mode breaks both).
NEON_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.c-x.region.aws.neon.tech/deal?sslmode=require

# HMAC secret for short-lived access-token JWTs (HS256). Required, no default —
# a weak/default secret in dev tends to survive into production. Generate:
#   openssl rand -base64 48
# Rotate = all issued access tokens die immediately (max exposure is the TTL).
JWT_ACCESS_SECRET=

# ── Cloudflare R2 (S3-compatible object storage) — required since Phase 7 ─────
# Deal files (previews/finals) live here. The bucket must be PRIVATE: the API
# grants time-limited presigned PUT/GET URLs and enforces file gating (finals
# require approval + full payment + release). R2_PUBLIC_BASE_URL below is NOT
# used for deal files — never enable public access on the deal-file bucket.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# Optional public r2.dev host, reserved for genuinely public assets
# (e.g. avatars). Safe to omit.
R2_PUBLIC_BASE_URL=

# ── Flutterwave v3 (default payment rail) — required since Phase 8 ────────────
# Server-side SECRET key (initialize + verify). The PUBLIC key is a browser
# credential — it belongs to the Phase 10 frontend env, not here. Use TEST keys
# in development (FLWSECK_TEST-...) and LIVE keys in production.
FLW_SECRET_KEY=
# Shared secret echoed in the `verif-hash` header of Flutterwave webhooks.
# Required in production. Development may omit it, in which case webhook
# delivery is rejected rather than processed without verification. Set the
# same value here and in Flutterwave Dashboard > Settings > Webhooks.
FLW_WEBHOOK_SECRET_HASH=

# ── Paystack (optional second rail) ───────────────────────────────────────────
# Required in production because Paystack is offered in the live checkout.
# Its webhook signature is verified with the same key (HMAC-SHA512 raw body).
PAYSTACK_SECRET_KEY=
