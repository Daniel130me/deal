# DEAL frontend — copy to .env and fill in.

# Base URL of the NestJS backend (global prefix included).
# Production (independent deploy): https://api.deal.example.com/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Sandbox-only: when set, every request appends ?XTransformPort=<port> so the
# preview gateway forwards it to the backend port. ALWAYS unset in production.
NEXT_PUBLIC_API_PORT=
